{
  "name": "executive-agent-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../.env -- next dev -p 3100",
    "build": "next build",
    "start": "dotenv -e ../.env -- next start -p 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "dotenv -e ../.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../.env -- node scripts/migrate.mjs",
    "db:studio": "dotenv -e ../.env -- drizzle-kit studio"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.2",
    "@ag-ui/core": "^1.0.2",
    "@ag-ui/encoder": "^1.0.2",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "next": "16.4.0",
    "pdfjs-dist": "^6.3.289",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
