      "parameters": {
        "jsCode": "const { headers = {}, body = {} } = $input.first().json;\nif (!$env.N8N_SHARED_SECRET || headers['x-webhook-secret'] !== $env.N8N_SHARED_SECRET) {\n  throw new Error('Rejected: missing or wrong x-webhook-secret header.');\n}\nif (!body.document_id || !body.workspace_id) throw new Error('document_id and workspace_id are required.');\nreturn [{ json: { documentId: body.document_id, workspaceId: body.workspace_id } }];\n"
      },
