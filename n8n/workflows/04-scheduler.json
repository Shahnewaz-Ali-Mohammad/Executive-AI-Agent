        "subject": "={{ $json.email.subject }}",
        "emailFormat": "both",
        "text": "={{ $json.email.text }}",
        "html": "={{ $json.email.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "bbe4faa7-3505-551e-9123-bebed927fead",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1320,
        -200
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "smtp": {
          "id": "ExecAgentSmtp001",
          "name": "SMTP (Executive Agent)"
        }
      },
      "notes": "Uses the SMTP account from .env (SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM)."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.APP_INTERNAL_URL || 'http://host.docker.internal:3100').replace(/\\/$/, '') }}/api/internal/automation/runs/{{ $('Run it').item.json.runId }}/delivered",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "={{ $env.N8N_SHARED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: 'sent', error: null }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "3c8b0b76-ffca-5da2-8c36-a4cdc24a0ec6",
      "name": "Tell app: sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        -280
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.APP_INTERNAL_URL || 'http://host.docker.internal:3100').replace(/\\/$/, '') }}/api/internal/automation/runs/{{ $('Run it').item.json.runId }}/delivered",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "={{ $env.N8N_SHARED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: 'failed', error: String($json.error?.message ?? $json.error ?? 'The SMTP server refused the email.').slice(0, 1000) }) }}",
        "options": {
          "timeout": 30000
        }
      },
