            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "84e94f33-8b93-5f6f-88ca-4100649371db",
              "leftValue": "={{ Boolean($env.SMTP_HOST) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "da3ac451-75d1-5861-b2ce-f3c83c474e7c",
      "name": "SMTP set up?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        -100
