# =============================================================================
#  Executive Agent — configuration
#  Copy this file to ".env" (same folder) and fill in the values.
#  This ONE file is read by Docker Compose (Postgres, Qdrant, n8n) AND by the
#  Next.js web app. Never commit the real .env to git.
# =============================================================================

# --- Web app ------------------------------------------------------------------
# Password for the web app login. Leave empty ONLY for local development.
APP_PASSWORD=change-this-password
# Random string (32+ chars) that signs the login cookie.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string-0123456789abcdef

# Which engine does the AI work (all real modes use OpenAI + Qdrant):
#   "openai" = the web app calls OpenAI directly. Simplest: n8n isn't needed.
#   "n8n"    = the same steps run as n8n workflows you can edit visually.
#   "mock"   = try the app without any AI keys (keyword search only).
AI_BACKEND=openai

# Largest upload in MB, and how long indexing may take before it's marked failed.
MAX_UPLOAD_MB=50
INGEST_TIMEOUT_MINUTES=30
# Where uploaded originals are stored (relative to /web).
STORAGE_DIR=./storage

# --- Postgres -------------------------------------------------------------------
POSTGRES_USER=exec
POSTGRES_PASSWORD=exec-local-password
POSTGRES_DB=executive_agent
# How the web app (running on your machine) reaches Postgres.
DATABASE_URL=postgres://exec:exec-local-password@localhost:55432/executive_agent

# --- n8n -------------------------------------------------------------------------
# How the web app reaches n8n.
N8N_BASE_URL=http://localhost:5678
# How n8n (inside Docker) reaches the web app: "document is ready" callbacks and
# the scheduler (tasks, scheduled reports, reminders), which calls it every minute.
APP_INTERNAL_URL=http://host.docker.internal:3100
# Shared secret between the web app and n8n (both directions).
# Generate with:  openssl rand -hex 32
N8N_SHARED_SECRET=replace-with-another-long-random-string
# Encrypts credentials stored inside n8n. Set once and never change it.
N8N_ENCRYPTION_KEY=replace-with-a-third-long-random-string
GENERIC_TIMEZONE=Asia/Dhaka

# --- Scheduler: tasks, scheduled reports and reminders -------------------------------
# Run by n8n (workflow 4). Results always appear under the bell in the app.
# Time zone used when the browser doesn't say which one it's in.
DEFAULT_TIME_ZONE=Asia/Dhaka
# Link to the app put in emails (your company URL or ngrok address).
APP_PUBLIC_URL=http://localhost:3100

# Optional email (n8n sends it). Leave SMTP_HOST empty to keep everything in the app.
# Gmail: smtp.gmail.com, port 587, your address, and an App Password (not your normal password).
# Microsoft 365: smtp.office365.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown on the emails (defaults to SMTP_USER).
SMTP_FROM=

# --- Qdrant (vector search) ----------------------------------------------------------
# Where the web app reaches Qdrant (used by AI_BACKEND=openai).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=executive_docs
# Optional API key for Qdrant. Leave empty for local use.
QDRANT_API_KEY=

# --- OpenAI (needed when AI_BACKEND=openai or n8n) -----------------------------------
# One key runs everything: answers, reading scans/photos, digests, search and voice.
# Get it at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Answers for Brief, Compare, Prep me and Draft.
OPENAI_MODEL=gpt-6.1-sol
# Stronger model for Deep dive and Risk scan.
OPENAI_MODEL_DEEP=gpt-6-astra
# Fast, cheap model: reads scans and photos, writes the upload digest.
OPENAI_MODEL_FAST=gpt-6-luna
# Voice fallback (only for browsers without built-in dictation).
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Search embeddings. Dimensions must match the model:
# 3072 for text-embedding-3-large, 1536 for text-embedding-3-small.
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# --- Advanced (leave empty normally) ------------------------------------------------
# Override the OpenAI endpoint, e.g. to go through a company gateway.
OPENAI_BASE_URL=
